{
  "name": "follow-through-agentic-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node build/src/index.js",
    "test": "npm run build && node --test build/test/*.test.js",
    "test:watch": "tsx --test --watch test/*.test.ts",
    "format": "biome format --write src test scripts",
    "lint": "biome lint src test scripts",
    "check": "npm run format && npm run lint && npm test",
    "agent:provision": "tsx scripts/provision-agent.ts",
    "tunnel": "tsx scripts/tunnel.ts",
    "smoke:corti": "tsx scripts/smoke-corti.ts",
    "smoke:handover": "tsx scripts/smoke-handover.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@corti/sdk": "5.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@ngrok/ngrok": "1.7.0",
    "@types/express": "4.17.25",
    "@types/node": "22.19.20",
    "tsx": "4.23.0",
    "typescript": "5.9.3"
  }
}
