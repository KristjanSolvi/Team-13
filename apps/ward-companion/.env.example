# Leave these blank in local development to use the Vite proxies configured in
# vite.config.ts. Never place Corti credentials or Agentic bearer tokens here.
VITE_PIPELINE_BASE_URL=
VITE_INTEGRATION_API_URL=

# Server-side proxy targets. These are service locations, not browser secrets.
PIPELINE_BASE_URL=http://127.0.0.1:8787
INTEGRATION_API_URL=http://127.0.0.1:8790
