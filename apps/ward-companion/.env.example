# The browser always uses the same-origin /follow-through-api boundary. Vite
# proxies it in development; the built Railway server uses this target.
# This is a server-side service location, not a browser secret.
INTEGRATION_API_URL=http://127.0.0.1:8790

# Only the server uses this for privileged grounded-handover requests.
# Never put it in a VITE_* variable.
INTEGRATION_API_BEARER_TOKEN=

# Presenter-only key used to unlock synthetic-time demo controls. Keep it on
# the UI server; the browser exchanges it for a short-lived signed session.
DEMO_HOST_ACCESS_KEY=
